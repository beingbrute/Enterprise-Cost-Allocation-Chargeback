{
  "name": "Halden Finance",
  "dataColors": ["#1F4E79", "#E9A23B", "#2A9D8F", "#6C7A89", "#8FB8DE", "#C0504D", "#7FB069", "#B07AA1"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#1F4E79",
  "good": "#2E8B57",
  "neutral": "#E9A23B",
  "bad": "#C0392B",
  "maximum": "#1F4E79",
  "center": "#F2F2F2",
  "minimum": "#C0392B",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#1F4E79" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4A5563" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#DDE2E8" } }, "radius": 6 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2A37" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }]
      }
    }
  }
}
